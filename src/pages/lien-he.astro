---
import { Image } from "astro:assets";
import HeroBreadcrumb from "../components/HeroBreadcrumb.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const title = `Liên hệ | ${site.name}`;
const description =
  "Thông tin liên hệ trực tiếp của CNN Legal qua email và điện thoại.";
const pagePath = "/lien-he/";
const pageUrl = new URL(pagePath, site.canonicalBaseUrl).toString();
const legalServiceData = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  name: site.name,
  url: site.canonicalBaseUrl,
  description: site.description,
  sameAs: [site.externalProfileUrl, site.linkedInUrl],
  telephone: site.publicPhone,
  email: site.publicEmail,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.streetAddress,
    addressLocality: site.address.addressLocality,
    addressRegion: site.address.addressRegion,
    addressCountry: site.address.addressCountry,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: site.geo.latitude,
    longitude: site.geo.longitude,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: "08:00",
    closes: "17:00",
  },
};
const structuredData = [
  legalServiceData,
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: title,
    description,
    url: pageUrl,
    inLanguage: "vi-VN",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Trang chủ", item: site.canonicalBaseUrl },
      { "@type": "ListItem", position: 2, name: "Liên hệ", item: pageUrl },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonicalPath={pagePath} structuredData={structuredData}>

  <section class="relative overflow-hidden py-24 md:py-32 lg:py-40">
    <div class="absolute inset-0 z-0">
      <Image
        src="/images/lien-he-hero.png"
        alt="Liên hệ với chúng tôi"
        class="h-full w-full object-cover object-center"
        width={1920}
        height={1080}
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-black/50"></div>
    </div>
    <div class="section-shell relative z-10">
      <HeroBreadcrumb items={[{ label: "Trang chủ", href: "/" }, { label: "Liên hệ" }]} />
      <h1 class="mt-8 max-w-3xl font-sans text-[2.25rem] font-semibold leading-[1.14] tracking-[-0.01em] text-white md:text-[2.75rem] lg:text-[3.125rem]">
        Liên hệ với chúng tôi
      </h1>
      <p class="mt-6 max-w-xl font-sans text-[1rem] leading-[1.8] text-white/80 md:text-[1.0625rem]">
        Mọi thông tin trao đổi ban đầu đều được giữ kín. Khi cần chia sẻ tài liệu, chúng tôi sẽ thống nhất cách thức phù hợp trước.
      </p>
    </div>
  </section>

  <section class="bg-panel-cream">
    <div class="section-shell py-16 md:py-24">
      <div class="grid gap-16 lg:grid-cols-[1fr_1.2fr] lg:gap-20">

        <div class="space-y-8 font-sans text-[1rem] leading-[1.85] text-text-dark">
          <div>
            <p class="text-[1.0625rem] font-medium text-text-dark">Văn phòng</p>
            <div class="mt-3 h-px w-8 bg-text-dark"></div>
          </div>

          <div>
            <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.08em] text-text-dark">Email</p>
            <a class="mt-1 block text-[1rem] leading-[1.85] text-text-dark hover:text-deep-blue-navy" href={`${site.publicEmailHref}?subject=${encodeURIComponent('Yêu cầu tư vấn pháp lý – CNN Legal')}`}>
              {site.publicEmail}
            </a>
          </div>

          <div>
            <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.08em] text-text-dark">Hotline</p>
            <a class="mt-1 block text-[1rem] leading-[1.85] text-text-dark hover:text-deep-blue-navy" href={site.publicPhoneHref}>
              {site.publicPhone}
            </a>
          </div>

          <div>
            <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.08em] text-text-dark">Địa chỉ</p>
            <p class="mt-1 text-[1rem] leading-[1.85] text-text-dark">{site.addressDisplay}</p>
          </div>

          <div>
            <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.08em] text-text-dark">Thời gian làm việc</p>
            <p class="mt-1 text-[1rem] leading-[1.85] text-text-dark">{site.workingHoursDisplay}</p>
          </div>

          <div class="mt-8 overflow-hidden rounded-xl border border-input-border">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.2979383976517!2d106.76532397666304!3d10.788477589361069!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x317527003ee47bdf%3A0x75dc07e36f22f8e1!2zQ8O0bmcgdHkgTHXhuq10IENOTiBMZWdhbA!5e0!3m2!1svi!2s!4v1784172388898!5m2!1svi!2s"
              width="100%"
              height="280"
              style="border:0; display:block;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              title="Vị trí văn phòng CNN Legal trên Google Maps"
            ></iframe>
          </div>
        </div>

        <div>
          <form id="contact-form" novalidate>

          <div id="cf-fields">
            <p class="text-[1.0625rem] font-medium text-text-dark">Gửi liên hệ đến CNN Legal</p>
            <div class="mt-3 h-px w-8 bg-text-dark"></div>

            <div class="mt-8 space-y-5">
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="cf-name" class="block text-[0.875rem] font-normal text-text-dark">
                  Họ tên <span class="text-red-500" aria-hidden="true">*</span>
                </label>
                <input
                  id="cf-name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  class="mt-2 w-full rounded-xl border border-input-border bg-white px-4 py-3 text-[0.9375rem] text-text-dark placeholder:text-text-muted focus:border-text-dark focus:outline-none"
                  placeholder="Họ tên của bạn"
                />
              </div>
              <div>
                <label for="cf-phone" class="block text-[0.875rem] font-normal text-text-dark">
                  Số điện thoại <span class="text-red-500" aria-hidden="true">*</span>
                </label>
                <input
                  id="cf-phone"
                  name="phone"
                  type="tel"
                  required
                  autocomplete="tel"
                  class="mt-2 w-full rounded-xl border border-input-border bg-white px-4 py-3 text-[0.9375rem] text-text-dark placeholder:text-text-muted focus:border-text-dark focus:outline-none"
                  placeholder="Số điện thoại để luật sư liên hệ"
                />
              </div>
            </div>

            <div>
              <label for="cf-email" class="block text-[0.875rem] font-normal text-text-dark">
                Email
              </label>
              <input
                id="cf-email"
                name="email"
                type="email"
                autocomplete="email"
                class="mt-2 w-full rounded-xl border border-input-border bg-white px-4 py-3 text-[0.9375rem] text-text-dark placeholder:text-text-muted focus:border-text-dark focus:outline-none"
                placeholder="Email nhận phản hồi"
              />
            </div>

            <div>
              <label for="cf-field" class="block text-[0.875rem] font-normal text-text-dark">
                Lĩnh vực <span class="text-red-500" aria-hidden="true">*</span>
              </label>
              <select
                id="cf-field"
                name="field"
                required
                class="mt-2 w-full rounded-xl border border-input-border bg-white px-4 py-3 text-[0.9375rem] text-text-dark focus:border-text-dark focus:outline-none"
              >
                <option value="" disabled selected style="color: #9ca3af;">— Chọn lĩnh vực —</option>
                <option value="Hình sự">Hình sự</option>
                <option value="Đất đai / Dân sự">Đất đai / Dân sự</option>
                <option value="Doanh nghiệp / Thương mại">Doanh nghiệp / Thương mại</option>
                <option value="Lao động">Lao động</option>
                <option value="Nghiên cứu & phản biện pháp luật">Nghiên cứu &amp; phản biện pháp luật</option>
              </select>
            </div>

            <div>
              <label for="cf-subject" class="block text-[0.875rem] font-normal text-text-dark">
                Tiêu đề
              </label>
              <input
                id="cf-subject"
                name="subject"
                type="text"
                class="mt-2 w-full rounded-xl border border-input-border bg-white px-4 py-3 text-[0.9375rem] text-text-dark placeholder:text-text-muted focus:border-text-dark focus:outline-none"
                placeholder="Mô tả ngắn gọn vụ việc..."
              />
            </div>

            <div>
              <label for="cf-message" class="block text-[0.875rem] font-normal text-text-dark">
                Nội dung <span class="text-red-500" aria-hidden="true">*</span>
              </label>
              <textarea
                id="cf-message"
                name="message"
                required
                rows="5"
                class="mt-2 w-full rounded-xl resize-none border border-input-border bg-white px-4 py-3 text-[0.9375rem] text-text-dark placeholder:text-text-muted focus:border-text-dark focus:outline-none"
                placeholder="Mô tả chi tiết vụ việc hoặc câu hỏi của bạn..."
              ></textarea>
            </div>

            <div id="cf-error" class="hidden rounded border border-red-200 bg-red-50 px-4 py-3 text-[0.875rem] text-red-800"></div>

            <button
              type="submit"
              id="cf-submit"
              class="inline-flex items-center gap-2 rounded-full bg-ink-black px-7 py-3 text-[0.9375rem] font-medium text-white transition-colors hover:bg-ink-hover active:scale-[0.97] disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span id="cf-submit-text">Gửi yêu cầu</span>
              <svg id="cf-spinner" class="hidden h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
              </svg>
            </button>
            </div>
          </div>

          <div id="cf-success" class="hidden min-h-[34rem] flex flex-col justify-center relative overflow-hidden rounded-xl border border-border-soft px-8 py-8">
            <Image
              src="/images/contact-success-bg.jpg"
              alt=""
              class="absolute inset-0 h-full w-full object-cover"
              width={1200}
              height={630}
            />
            <div class="relative z-10 max-w-md">
              <p class="[font-family:system-ui] text-[34px] font-bold leading-tight tracking-[-0.02em] text-black">Cảm ơn bạn đã gửi yêu cầu liên hệ.</p>
              <p class="mt-4 [font-family:system-ui] text-[19px] leading-relaxed text-black">Chúng tôi sẽ nhanh chóng phản hồi lại qua email hoặc số điện thoại.</p>
            </div>
          </div>
          </form>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const fieldsContainer = document.getElementById('cf-fields') as HTMLDivElement;
  const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement;
  const submitText = document.getElementById('cf-submit-text') as HTMLSpanElement;
  const spinner = document.getElementById('cf-spinner') as HTMLElement;
  const successMsg = document.getElementById('cf-success') as HTMLDivElement;
  const errorMsg = document.getElementById('cf-error') as HTMLDivElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    successMsg.classList.add('hidden');
    errorMsg.classList.add('hidden');

    const data = {
      name: (form.elements.namedItem('name') as HTMLInputElement).value.trim(),
      phone: (form.elements.namedItem('phone') as HTMLInputElement).value.trim(),
      email: (form.elements.namedItem('email') as HTMLInputElement).value.trim(),
      field: (form.elements.namedItem('field') as HTMLSelectElement).value,
      subject: (form.elements.namedItem('subject') as HTMLInputElement).value.trim(),
      message: (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim(),
    };

    if (!data.name || !data.phone || !data.field || !data.message) {
      errorMsg.textContent = 'Vui lòng điền đầy đủ các trường bắt buộc (*)';
      errorMsg.classList.remove('hidden');
      return;
    }

    const isTestSubmission =
      data.message.trim().toLowerCase() === 'test' &&
      data.field === 'Doanh nghiệp / Thương mại';
    if (isTestSubmission) {
      form.reset();
      fieldsContainer.classList.add('hidden');
      successMsg.classList.remove('hidden');
      return;
    }

    submitBtn.disabled = true;
    submitText.textContent = 'Đang gửi...';
    spinner.classList.remove('hidden');

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
        signal: AbortSignal.timeout(15000),
      });
      const json = await res.json();

      if (res.ok && json.success) {
        form.reset();
        fieldsContainer.classList.add('hidden');
        successMsg.classList.remove('hidden');
      } else {
        errorMsg.textContent = json.error || 'Đã có lỗi xảy ra. Vui lòng thử lại sau.';
        errorMsg.classList.remove('hidden');
      }
    } catch {
      errorMsg.textContent = 'Không thể kết nối hoặc yêu cầu hết thời gian chờ. Vui lòng thử lại.';
      errorMsg.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitText.textContent = 'Gửi yêu cầu';
      spinner.classList.add('hidden');
    }
  });
</script>
