---
import HeroBreadcrumb from "../components/HeroBreadcrumb.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const title = `Liên hệ | ${site.name}`;
const description =
  "Thông tin liên hệ trực tiếp của CNN Legal qua email và điện thoại. Website không có biểu mẫu liên hệ.";
const pagePath = "/lien-he/";
const pageUrl = new URL(pagePath, site.canonicalBaseUrl).toString();
const legalServiceData = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  name: site.name,
  url: site.canonicalBaseUrl,
  description: site.description,
  sameAs: [site.externalProfileUrl, site.linkedInUrl],
  telephone: site.publicPhone,
  email: site.publicEmail,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.streetAddress,
    addressLocality: site.address.addressLocality,
    addressRegion: site.address.addressRegion,
    addressCountry: site.address.addressCountry,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: site.geo.latitude,
    longitude: site.geo.longitude,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: "08:00",
    closes: "17:00",
  },
};
const structuredData = [
  legalServiceData,
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: title,
    description,
    url: pageUrl,
    inLanguage: "vi-VN",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Trang chủ", item: site.canonicalBaseUrl },
      { "@type": "ListItem", position: 2, name: "Liên hệ", item: pageUrl },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonicalPath={pagePath} structuredData={structuredData}>
  
  <section class="relative overflow-hidden py-24 md:py-32 lg:py-40">
    
    <div class="absolute inset-0 z-0">
      <img
        src="/images/lien-he-hero.png"
        alt="Liên hệ với chúng tôi"
        class="h-full w-full object-cover object-center"
      />
      
      <div class="absolute inset-0 bg-black/50"></div>
    </div>

    
    <div class="section-shell relative z-10">
      <HeroBreadcrumb items={[{ label: "Trang chủ", href: "/" }, { label: "Liên hệ" }]} />

      <h1 class="mt-8 max-w-3xl font-sans text-[2.25rem] font-semibold leading-[1.14] tracking-[-0.01em] text-white md:text-[2.75rem] lg:text-[3.125rem]">
        Liên hệ với chúng tôi
      </h1>

      <p class="mt-6 max-w-xl font-sans text-[1rem] leading-[1.8] text-white/80 md:text-[1.0625rem]">
        Mọi thông tin trao đổi ban đầu đều được giữ kín. Khi cần chia sẻ tài liệu, chúng tôi sẽ thống nhất cách thức phù hợp trước.
      </p>
    </div>
  </section>

  
  <section class="bg-[#f0f0ec]">
    <div class="section-shell py-16 md:py-24">
      <div class="grid gap-10 md:grid-cols-[200px_1fr] lg:grid-cols-[240px_1fr]">
        <div class="pt-1">
          <p class="font-sans text-[1.0625rem] font-medium text-text-dark">Văn phòng</p>
          <div class="mt-3 h-px w-8 bg-text-dark"></div>
        </div>
        <div class="space-y-8 font-sans text-[1rem] leading-[1.85] text-text-dark">
          
          <div>
            <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.08em] text-text-dark">Email</p>
            <a class="mt-1 block text-[1rem] leading-[1.85] text-text-dark hover:text-deep-blue-navy" href={`${site.publicEmailHref}?subject=${encodeURIComponent('Yêu cầu tư vấn pháp lý – CNN Legal')}`}>
              {site.publicEmail}
            </a>
          </div>

          
          <div>
            <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.08em] text-text-dark">Hotline</p>
            <a class="mt-1 block text-[1rem] leading-[1.85] text-text-dark hover:text-deep-blue-navy" href={site.publicPhoneHref}>
              {site.publicPhone}
            </a>
          </div>

          
          <div>
            <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.08em] text-text-dark">Địa chỉ</p>
            <p class="mt-1 text-[1rem] leading-[1.85] text-text-dark">
              {site.addressDisplay}
            </p>
          </div>

          
          <div>
            <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.08em] text-text-dark">Thời gian làm việc</p>
            <p class="mt-1 text-[1rem] leading-[1.85] text-text-dark">
              {site.workingHoursDisplay}
            </p>
          </div>

          
          <div class="mt-12 inline-flex overflow-hidden border border-[#7c7c7c] bg-[#1a1a1a]" aria-label="Liên kết nhanh">
            
            <a
              href="mailto:cnnlegal.vn@gmail.com"
              class="flex h-14 w-16 items-center justify-center border-r border-[#7c7c7c] transition-colors hover:bg-[#252525]"
              aria-label="Gửi email"
            >
              <img class="h-7 w-7 object-contain" src="/images/gmail-logo.png" alt="" loading="lazy" />
            </a>

            
            <a
              href="https://www.google.com/maps/place/C%C3%B4ng+ty+Lu%E1%BA%ADt+CNN+Legal/@10.7884776,106.765324,17z/data=!3m1!4b1!4m6!3m5!1s0x317527003ee47bdf:0x75dc07e36f22f8e1!8m2!3d10.7884776!4d106.7678989!16s%2Fg%2F11zbqqq4mz?entry=ttu&g_ep=EgoyMDI2MDcwOC4wIKXMDSoASAFQAw%3D%3D"
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-14 w-16 items-center justify-center border-r border-[#7c7c7c] transition-colors hover:bg-[#252525]"
              aria-label="Xem trên Google Maps"
            >
              <img class="h-8 w-8 object-contain" src="/images/google-maps-logo.png" alt="" loading="lazy" />
            </a>

            
            <a
              href="https://masothue.com/0319315660-cong-ty-luat-trach-nhiem-huu-han-mot-thanh-vien-cnn-legal"
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-14 w-20 items-center justify-center transition-colors hover:bg-[#252525]"
              aria-label="Tra cứu mã số thuế"
            >
              <img class="h-5 w-16 object-contain" src="/images/masothue-logo.png" alt="" loading="lazy" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
