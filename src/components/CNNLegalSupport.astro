<div id="cnn-legal-support" data-lazy-widget>
  <button id="cnn-support-icon" class="support-icon" aria-label="Open CNN Legal Support">
    <svg class="icon-chat" xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 -2 24 26" fill="white">
      <path d="M3.5 4 C3.5 2.3 4.8 1 6.5 1 L17.5 1 C19.2 1 20.5 2.3 20.5 4 L20.5 16 C20.5 17.7 19.2 19 17.5 19 L10 19 L5.5 22.5 L5.5 19 L6.5 19 C4.8 19 3.5 17.7 3.5 16 Z"/>
      <path d="M8 12.5 Q12 14.5 16 12.5" stroke="#09A6DC" stroke-width="1.3" fill="none" stroke-linecap="round"/>
    </svg>
    <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div id="cnn-support-widget" class="support-widget" style="display: none;">
    <div class="widget-content">
      <div id="cnn-support-messages" class="messages-container">
        <div id="cnn-empty-state" class="empty-state">
          <div class="logo">
            CNN Legal <span class="support-text">Support</span>
          </div>
          <div class="welcome-message">
            Chúng tôi có thể giúp gì cho bạn không?
          </div>
        </div>
      </div>
    </div>
    <div class="widget-bottom">
      <div class="input-container">
        <div class="chatbox-wrapper">
          <div id="cnn-support-loading" class="loading-indicator hidden">
            <div class="spinner"></div>
            <span class="loading-text">Thinking</span>
          </div>
          <input
            type="text"
            id="cnn-support-input"
            class="message-input"
            placeholder="Ask a question"
            autocomplete="off"
          />
          <button id="cnn-support-send" class="send-button" aria-label="Send message">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="19" x2="12" y2="5"></line>
              <polyline points="5 12 12 5 19 12"></polyline>
            </svg>
          </button>
        </div>
      </div>
      <p class="disclaimer-text" style="padding: 8px 20px 16px; font-size: 10px; color: #9ca3af; text-align: center; background: #ffffff; line-height: 1.4; margin: 0;">
        By chatting, you agree to our <a href="/ai-disclaimer" target="_blank" style="color: #1c4e8c; text-decoration: underline;">disclaimer</a>
      </p>
    </div>
  </div>
</div>

<style is:global>
  #cnn-legal-support {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 9999;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }

  .support-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #09A6DC;
    border: none;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    transition: transform 200ms ease-in-out;
  }

  .support-icon:hover {
    transform: scale(1.08);
  }

  .support-widget {
    position: fixed;
    bottom: 90px;
    right: 20px;
    width: 420px;
    height: 500px;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: slideUp 300ms ease-in-out;
  }

  .widget-content {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 16px;
    scroll-behavior: smooth;
  }

  .widget-content::-webkit-scrollbar {
    width: 6px;
  }

  .widget-content::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 3px;
  }

  .widget-content::-webkit-scrollbar-thumb {
    background: #c1c1c1;
    border-radius: 3px;
  }

  .widget-content::-webkit-scrollbar-thumb:hover {
    background: #a8a8a8;
  }

  .messages-container {
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    min-height: 100%;
    width: 100%;
  }

  .empty-state {
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    transition: opacity 300ms ease-in-out;
  }

  .empty-state.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .logo {
    position: absolute;
    top: 16px;
    left: 16px;
    font-size: 14px;
    font-weight: 600;
    color: #0f1923;
  }

  .support-text {
    font-size: 12px;
    color: #9ca3af;
    margin-left: 4px;
    font-weight: 400;
  }

  .welcome-message {
    position: absolute;
    top: 56.6%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 18px;
    font-weight: 500;
    color: #111827;
    text-align: center;
    white-space: nowrap;
  }

  .message {
    display: flex;
    width: 100%;
    animation: messageSlideIn 0.2s ease-out;
  }

  @keyframes messageSlideIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .user-message {
    justify-content: flex-end;
  }

  .ai-message {
    justify-content: flex-start;
  }

  .message-content {
    max-width: 85%;
    font-size: 14px;
    line-height: 1.6;
    word-wrap: break-word;
    overflow-wrap: break-word;
    word-break: break-word;
    hyphens: auto;
    white-space: pre-wrap;
  }

  .user-message .message-content {
    background: #f3f4f6;
    color: #111827;
    padding: 10px 16px;
    border-radius: 20px;
  }

  .ai-message .message-content {
    background: transparent;
    color: #111827;
    border: none;
    padding: 0;
    margin-left: 0;
  }

  .ai-message .message-content strong,
  .ai-message .message-content b {
    font-weight: 600;
    color: #0f1923;
  }

  .ai-message .message-content p {
    margin: 0.5em 0;
  }

  .ai-message .message-content p:first-child {
    margin-top: 0;
  }

  .ai-message .message-content p:last-child {
    margin-bottom: 0;
  }

  .widget-bottom {
    margin-top: auto;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .input-container {
    padding: 16px 20px 0;
    background: #ffffff;
    border-top: 1px solid #e5e7eb;
  }

  .chatbox-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    border: 1px solid #333333;
    border-radius: 28px;
    background: #ffffff;
    padding: 4px;
    width: 100%;
    height: 40px;
    min-width: 350px;
  }

  .disclaimer-text {
    padding: 8px 20px 16px;
    font-size: 10px;
    color: #9ca3af;
    text-align: center;
    background: #ffffff;
    line-height: 1.4;
  }

  .message-input {
    flex: 1;
    padding: 8px 44px 8px 18px;
    border: none;
    background: transparent;
    font-size: 14px;
    outline: none;
    color: #1a1a1a;
    transition: padding-left 200ms ease;
  }

  .chatbox-wrapper:has(.loading-indicator:not(.hidden)) .message-input {
    padding-left: 100px;
  }

  .message-input::placeholder {
    color: #9ca3af;
  }

  .chatbox-wrapper:has(.loading-indicator:not(.hidden)) .message-input::placeholder {
    opacity: 0;
  }

  .send-button {
    position: absolute;
    right: 6px;
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 50%;
    background: #e5e7eb;
    border: none;
    color: #6b7280;
    cursor: not-allowed;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 200ms ease;
    pointer-events: none;
  }

  .send-button.is-active {
    background: #1c4e8c;
    color: #ffffff;
    cursor: pointer;
    pointer-events: auto;
  }

  .send-button.is-active:hover {
    background: #163d73;
    transform: scale(1.05);
  }

  .send-button:disabled {
    background: #e5e7eb;
    color: #9ca3af;
    cursor: not-allowed;
    pointer-events: none;
  }

  .loading-indicator {
    position: absolute;
    left: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    pointer-events: none;
  }

  .loading-indicator.hidden {
    display: none;
  }

  .spinner {
    width: 19.26px;
    height: 19.26px;
    border: 2.5px solid #e5e7eb;
    border-top-color: #1c4e8c;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .loading-text {
    font-size: 14px;
    color: #6b7280;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .support-widget {
      width: calc(100vw - 40px);
      height: calc(100vh - 120px);
      bottom: 80px;
      right: 20px;
    }
  }

  @media (max-width: 480px) {
    #cnn-legal-support {
      bottom: 16px;
      right: 16px;
    }

    .support-icon {
      width: 56px;
      height: 56px;
    }

    .support-widget {
      width: calc(100vw - 32px);
      height: calc(100vh - 100px);
      bottom: 80px;
      right: 16px;
    }

    .input-container {
      padding: 16px;
    }
  }
</style>

<script>
  import '../scripts/cnn-legal-support.ts';
</script>
