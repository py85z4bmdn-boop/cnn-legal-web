---
---

<div id="cnn-legal-support">
  <button id="cnn-support-icon" class="support-icon" aria-label="Open CNN Legal Support">
    <svg class="icon-chat" xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 64 64" role="img" aria-label="CNN Legal">
      <path d="M16 19h32v5H16zM20 30h24v4H20zM20 40h18v4H20z" fill="white"/>
      <path d="M15 50h34" stroke="#e08738" stroke-width="4" stroke-linecap="round"/>
    </svg>
    <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div id="cnn-support-widget" class="support-widget" style="display: none;">
    <div class="widget-header">
      <div class="logo">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="22" height="22" style="border-radius: 4px; flex-shrink: 0; margin-right: 2px;">
          <rect width="64" height="64" rx="10" fill="#1c4e8c"/>
          <path d="M16 19h32v5H16zM20 30h24v4H20zM20 40h18v4H20z" fill="#FAF7F0"/>
          <path d="M15 50h34" stroke="#e08738" stroke-width="4" stroke-linecap="round"/>
        </svg>
        <span class="logo-main">CNN Legal</span>
        <span class="logo-sub">Support</span>
      </div>
      <button id="cnn-support-close" class="close-button" aria-label="Close chat">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="widget-content">
      <h2 class="widget-title">Cần hỗ trợ? Chúng tôi có thể giúp gì?</h2>

      <div id="cnn-support-messages" class="messages-container">
        <div class="message user-message">
          <div class="message-content">
            xin chào
          </div>
        </div>
        <div class="message ai-message">
          <div class="ai-avatar">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="28" height="28" style="border-radius: 6px; flex-shrink: 0;">
              <rect width="64" height="64" rx="10" fill="#1c4e8c"/>
              <path d="M16 19h32v5H16zM20 30h24v4H20zM20 40h18v4H20z" fill="#FAF7F0"/>
              <path d="M15 50h34" stroke="#e08738" stroke-width="4" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="message-content">
            Xin chào! Tôi là trợ lý AI của CNN Legal. Tôi có thể giúp gì cho bạn?
          </div>
        </div>
      </div>
    </div>

    <div class="input-container">
      <input
        type="text"
        id="cnn-support-input"
        class="message-input"
        placeholder="Ask a question"
        autocomplete="off"
      />
      <button id="cnn-support-send" class="send-button" aria-label="Send message">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="19" x2="12" y2="5"></line>
          <polyline points="5 12 12 5 19 12"></polyline>
        </svg>
      </button>
    </div>
  </div>
</div>

<style is:global>
  #cnn-legal-support {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 9999;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  }

  .support-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #1c4e8c;
    border: none;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    transition: transform 200ms ease-in-out;
  }

  .support-icon:hover {
    transform: scale(1.08);
  }

  .support-widget {
    position: fixed;
    bottom: 90px;
    right: 20px;
    width: 380px;
    height: 400px;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: slideUp 300ms ease-in-out;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .widget-header {
    background: #ffffff;
    color: #1a1a1a;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #e5e7eb;
  }

  .logo {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .logo-main {
    font-size: 16px;
    font-weight: 800;
    color: #1a1a1a;
    letter-spacing: -0.02em;
  }

  .logo-sub {
    font-size: 12px;
    font-weight: 500;
    color: #6b7280;
  }

  .close-button {
    background: none;
    border: none;
    color: #6b7280;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: background-color 200ms ease;
  }

  .close-button:hover {
    background-color: #f3f4f6;
    color: #1a1a1a;
  }

  .widget-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 16px 20px;
  }

  .widget-title {
    margin: 0 0 16px 0;
    font-size: 18px;
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.3;
  }

  .messages-container {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #f9fafb;
    border-radius: 12px;
    max-height: 220px;
  }

  .messages-container::-webkit-scrollbar {
    width: 6px;
  }

  .messages-container::-webkit-scrollbar-track {
    background: #f3f4f6;
    border-radius: 3px;
  }

  .messages-container::-webkit-scrollbar-thumb {
    background: #d1d5db;
    border-radius: 3px;
  }

  .messages-container::-webkit-scrollbar-thumb:hover {
    background: #9ca3af;
  }

  .message {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    animation: fadeIn 300ms ease-in-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ai-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .message-content {
    max-width: 78%;
    padding: 9px 13px;
    border-radius: 12px;
    font-size: 13px;
    line-height: 1.5;
    word-wrap: break-word;
  }

  .user-message {
    justify-content: flex-end;
  }

  .user-message .message-content {
    background: #1c4e8c !important;
    color: #ffffff !important;
    border-radius: 12px 12px 4px 12px;
  }

  .ai-message {
    justify-content: flex-start;
  }

  .ai-message .message-content {
    background: #ffffff !important;
    color: #1a1a1a !important;
    border: 1px solid #e5e7eb;
    border-radius: 12px 12px 12px 4px;
  }

  .input-container {
    position: relative;
    padding: 16px 20px;
    background: #ffffff;
    border-top: 1px solid #e5e7eb;
  }

  .message-input {
    width: 100%;
    padding: 11px 50px 11px 18px;
    border: 1.5px solid #1a1a1a;
    border-radius: 24px;
    font-size: 13px;
    outline: none;
    background: #ffffff;
    color: #1a1a1a;
    transition: border-color 200ms ease;
  }

  .message-input::placeholder {
    color: #9ca3af;
  }

  .message-input:focus {
    border-color: #1a1a1a;
  }

  .send-button {
    position: absolute;
    right: 28px;
    top: 50%;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 50%;
    background: #d1d5db;
    border: none;
    color: #6b7280;
    cursor: not-allowed;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 200ms ease;
    pointer-events: none;
  }

  .send-button.is-active {
    background: #1c4e8c;
    color: #ffffff;
    cursor: pointer;
    pointer-events: auto;
  }

  .send-button.is-active:hover {
    background: #163d73;
  }

  .send-button:disabled {
    background: #d1d5db;
    color: #6b7280;
    cursor: not-allowed;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .support-widget {
      width: calc(100vw - 40px);
      height: calc(100vh - 120px);
      bottom: 80px;
      right: 20px;
    }

    .messages-container {
      max-height: none;
    }
  }

  @media (max-width: 480px) {
    #cnn-legal-support {
      bottom: 16px;
      right: 16px;
    }

    .support-icon {
      width: 56px;
      height: 56px;
    }

    .support-widget {
      width: calc(100vw - 32px);
      height: calc(100vh - 100px);
      bottom: 80px;
      right: 16px;
    }

    .widget-content {
      padding: 16px;
    }

    .widget-title {
      font-size: 18px;
    }

    .input-container {
      padding: 16px;
    }
  }
</style>

<script>
  import '../scripts/cnn-legal-support';
</script>